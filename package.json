{
  "name": "maptrail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "check:export": "node scripts/check-static-export.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "geography:europe": "node scripts/build-europe-geography.mjs",
    "clue-ladder:schemas": "node scripts/generate-clue-ladder-schemas.mjs",
    "clue-ladder:validate": "tsx scripts/validate-clue-ladder.ts",
    "clue-ladder:fixtures": "tsx scripts/build-clue-ladder-fixtures.ts",
    "clue-ladder:check-milestone": "tsx scripts/validate-clue-ladder.ts --require-audited-samples"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "next": "16.3.3",
    "posthog-js": "^1.434.15",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "topojson-client": "^3.1.0",
    "us-atlas": "3.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/topojson-client": "^3.1.0",
    "@types/topojson-specification": "^1.0.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "4.3.3",
    "ts-json-schema-generator": "^2.9.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "vitest": "4.1.11"
  }
}
